#!/bin/bash

TILE_NAME=metric-store
RELEASE_VERSION=${RELEASE_VERSION:-1.8.7-dev.$(date +%s)}
STEMCELL_VERSION=${STEMCELL_VERSION:-1.990}

PROJECT_DIR="$(cd "$(dirname "$0")/.."; pwd)"

echo_green() {
  GREEN='\033[0;32m'
  CLEAR='\033[0m'
  local message=${1}

  echo -e "${GREEN}${message}${CLEAR}"
}

echo_red() {
  RED='\033[0;31m'
  CLEAR='\033[0m'
  local message=${1}

  echo -e "${RED}${message}${CLEAR}"
}

mkdir -p ${PROJECT_DIR}/tmp/releases

echo_green "Creating p-metric-store release from local changes..."
git rev-parse HEAD > sha
bosh create-release --force --tarball=${PROJECT_DIR}/tmp/releases/metric-store.tgz

pushd ${PROJECT_DIR}/tmp
    echo_green $(pwd)
    RELEASE_URLS=(
      https://bosh.io/d/github.com/cloudfoundry/bpm-release
      https://bosh.io/d/github.com/cloudfoundry/routing-release
    )

    echo_green "Fetching releases for tile..."

    pushd releases
        for URL in ${RELEASE_URLS[@]}; do
            echo_green "Fetching release from ${URL}..."
            curl \
              --location \
              --remote-name \
              --remote-header-name \
              --silent \
              --retry 5 \
              ${URL} || true
            mv bpm-release ${PROJECT_DIR}/tmp/releases/bpm-release.tgz
            mv routing-release ${PROJECT_DIR}/tmp/releases/routing-release.tgz
        done
    popd
    echo_green "Releases downloaded to $(pwd)/releases"
    for release in routing-release bpm-release metric-store; do
      echo "Adding release: ${release}"
      mv releases/${release} releases/${release}-"${RELEASE_VERSION}".tgz
    done
    echo_green "Releases renamed to include version"
popd

TILE_FILE=${TILE_NAME}-${RELEASE_VERSION}.pivotal
echo_green "Creating tile $TILE_FILE"
echo_green "Baking tile $TILE_FILE"

# kiln bake is invoked from PROJECT_DIR (not tmp/) because tile/Kilnfile's
# bake_configurations paths (e.g. "tile/forms") are resolved relative to the
# current working directory, overriding the --forms-directory/--metadata/etc
# flags below whenever they're set.
#
# --skip-fetch is required for dev builds: without it, kiln's own fetch step
# treats our locally-built metric-store release as "extra" (its version
# doesn't match Kilnfile.lock's exact pin), deletes it, and re-downloads the
# last officially-published compiled release from Artifactory instead --
# silently discarding whatever local changes this release was built from.
kiln bake \
    --version "$RELEASE_VERSION" \
    --kilnfile ${PROJECT_DIR}/tile/Kilnfile \
    --metadata ${PROJECT_DIR}/tile/metadata.yml \
    --icon ${PROJECT_DIR}/tile/icon.png \
    --releases-directory ${PROJECT_DIR}/tmp/releases \
    --skip-fetch \
    --variable="stemcell_version=${STEMCELL_VERSION}" \
    --forms-directory ${PROJECT_DIR}/tile/forms \
    --properties-directory ${PROJECT_DIR}/tile/properties \
    --jobs-directory ${PROJECT_DIR}/tile/jobs \
    --instance-groups-directory ${PROJECT_DIR}/tile/instance_groups \
    --variables-file ${PROJECT_DIR}/tile/variables/kiln-vars.yml \
    --output-file ${PROJECT_DIR}/tmp/${TILE_FILE}
